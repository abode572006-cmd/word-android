 }
 
+#[cfg(not(target_arch = "wasm32"))]
+fn system_arabic_font() -> Option<&'static Vec<u8>> {
+    static FONT: std::sync::OnceLock<Option<Vec<u8>>> = std::sync::OnceLock::new();
+    FONT.get_or_init(|| {
+        const NAMES: &[&str] = &[
+            "NotoSansArabicUI-VF.ttf",
+            "NotoSansArabicUI-Regular.ttf",
+            "NotoNaskhArabicUI-VF.ttf",
+            "NotoNaskhArabicUI-Regular.ttf",
+            "NotoSansArabic-Regular.ttf",
+            "NotoNaskhArabic-Regular.ttf",
+            "NotoKufiArabic-Regular.ttf",
+            "DroidNaskh-Regular.ttf",
+            "DroidSansArabic.ttf",
+            "SamsungOneArabic-Regular.ttf",
+        ];
+        wordcraft_fonts::system_font_dirs().iter()
+            .flat_map(|dir| NAMES.iter().map(move |name| dir.join(name)))
+            .find_map(|path| {
+                let size = std::fs::metadata(&path).ok()?.len();
+                if size > (128 << 20) { return None; }
+                std::fs::read(path).ok()
+            })
+    }).as_ref()
+}
+
 pub fn medium(size: f32) -> FontId {
     FontId::new(size, FontFamily::Name("medium".into()))

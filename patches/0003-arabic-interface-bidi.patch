diff --git a/crates/ui-egui/src/i18n/bidi.rs b/crates/ui-egui/src/i18n/bidi.rs
new file mode 100644
--- /dev/null
+++ b/crates/ui-egui/src/i18n/bidi.rs
@@ -0,0 +1,118 @@
+//! egui lays a label out run by run and puts the runs left to right in the order it met them.
+//! It does not run the Unicode bidirectional algorithm, so an Arabic label can read with its
+//! words in reverse order. Reorder catalog labels into visual order before egui sees them.
+//!
+//! Characters inside an Arabic run remain in logical order because egui's text shaper shapes
+//! right-to-left runs itself. Latin words and numbers remain left-to-right. Brackets are mirrored
+//! as UAX #9 L4 requires. Only catalog lookups pass through this module: text a user types into
+//! a document or field remains in logical order.
+
+use unicode_bidi::{BidiClass, BidiInfo, Level};
+
+/// Arabic/Hebrew strong characters and nonspacing marks that belong to their shaping run.
+fn is_rtl_shaped(c: char) -> bool {
+    matches!(unicode_bidi::bidi_class(c), BidiClass::R | BidiClass::AL | BidiClass::NSM)
+}
+
+fn mirror(c: char) -> char {
+    match c {
+        '(' => ')',
+        ')' => '(',
+        '[' => ']',
+        ']' => '[',
+        '{' => '}',
+        '}' => '{',
+        '<' => '>',
+        '>' => '<',
+        _ => c,
+    }
+}
+
+/// Convert a logical-order label into the visual run order expected by egui 0.36.
+/// Newlines are reordered independently; labels without RTL characters are unchanged.
+pub fn visual_rtl(label: &str) -> String {
+    if !label.chars().any(is_rtl_shaped) {
+        return label.into();
+    }
+    let mut out = String::with_capacity(label.len());
+    let mut first = true;
+    for line in label.split('\n') {
+        if !first {
+            out.push('\n');
+        }
+        first = false;
+        visual_rtl_line(line, &mut out);
+    }
+    out
+}
+
+fn visual_rtl_line(line: &str, out: &mut String) {
+    let bidi = BidiInfo::new(line, Some(Level::rtl()));
+    let Some(para) = bidi.paragraphs.first() else {
+        out.push_str(line);
+        return;
+    };
+    let chars: Vec<char> = line.chars().collect();
+    let levels = bidi.reordered_levels_per_char(para, para.range.clone());
+    let order = BidiInfo::reorder_visual(&levels);
+    let mut p = 0;
+    while p < order.len() {
+        let i = order[p];
+        if is_rtl_shaped(chars[i]) {
+            // Emit each RTL shaping run in logical order, even though the run itself moved.
+            let (mut lo, mut hi) = (i, i);
+            let mut end = p + 1;
+            loop {
+                if let Some(&j) = order.get(end)
+                    && is_rtl_shaped(chars[j])
+                    && (j + 1 == lo || j == hi + 1)
+                {
+                    lo = lo.min(j);
+                    hi = hi.max(j);
+                    end += 1;
+                } else {
+                    break;
+                }
+            }
+            let mut j = lo;
+            while j <= hi {
+                out.push(chars[j]);
+                j += 1;
+            }
+            p = end;
+        } else {
+            let c = chars[i];
+            out.push(if levels[i].is_rtl() { mirror(c) } else { c });
+            p += 1;
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn runs_are_in_visual_order_and_letters_stay_logical() {
+        assert_eq!(visual_rtl("إعداد المستند"), "المستند إعداد");
+        assert_eq!(visual_rtl("تحرير لوحات الرسم"), "الرسم لوحات تحرير");
+        assert_eq!(visual_rtl("المعاينة"), "المعاينة");
+        assert_eq!(visual_rtl("عنصراً جديد"), "جديد عنصراً");
+    }
+
+    #[test]
+    fn latin_numbers_and_punctuation_keep_their_own_order() {
+        assert_eq!(visual_rtl("حفظ كـ PDF…"), "…PDF كـ حفظ");
+        assert_eq!(visual_rtl("تصدير كـ SVG"), "SVG كـ تصدير");
+        assert_eq!(visual_rtl("إنشاء 3 نسخ"), "نسخ 3 إنشاء");
+        assert_eq!(visual_rtl("حفظ (النسخة الحالية)"), "(الحالية النسخة) حفظ");
+    }
+
+    #[test]
+    fn lines_are_reordered_independently_and_ltr_is_unchanged() {
+        assert_eq!(visual_rtl("سطر أول\nسطر ثانٍ"), "أول سطر\nثانٍ سطر");
+        assert_eq!(visual_rtl("سطر أول\nPDF"), "أول سطر\nPDF");
+        assert_eq!(visual_rtl("Plain label, 3 of them."), "Plain label, 3 of them.");
+        assert_eq!(visual_rtl(""), "");
+    }
+}

+/// Arabic with vowel marks, Arabic-Indic digits and embedded Latin text follows UAX #9.
+#[test]
+fn arabic_paragraph_handles_marks_and_mixed_direction_runs() {
+    let text = "السَّلَامُ عَلَيْكُمْ WordCraft ١٢٣، PDF 2026";
+    let levels = bidi_levels(text, true);
+    assert_eq!(levels.len(), text.len());
+    assert_eq!(levels[0] % 2, 1, "Arabic starts in an RTL run");
+    let latin = text.find("WordCraft").unwrap();
+    assert_eq!(levels[latin] % 2, 0, "Latin brand name stays LTR");
+    let pdf = text.find("PDF").unwrap();
+    assert_eq!(levels[pdf] % 2, 0, "Latin abbreviation stays LTR");
+    let doc = doc_of(&[(text, true)]);
+    let layout = lay(&doc);
+    let (_, line_left) = first_line(&layout, 0);
+    // The line box's x is its left edge, not the visual start of RTL text.
+    assert!((line_left - 72.0).abs() < 1.0, "line box retains the page's left margin: {line_left}");
+    let caret = layout.caret(&Pos::body(0, 0)).unwrap();
+    assert!((caret.x - (612.0 - 72.0)).abs() < 1.0, "the initial RTL caret belongs at the right margin: {caret:?}");
+}

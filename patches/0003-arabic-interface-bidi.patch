+fn arabic_catalog_is_complete_and_uses_visual_order_for_egui() {
+    let ar = Lang::from_code("ar").expect("Arabic is registered");
+    let (entries, errors) = super::catalog::parse_entries(ar.0.source);
+    assert!(errors.is_empty(), "{errors:?}");
+    assert_eq!(entries.len(), 1729, "all upstream interface keys are present");
+    let translated = entries.iter().filter(|entry| entry.source != entry.translation).count();
+    assert_eq!(translated, 1713, "only product names, shortcuts and technical abbreviations remain unchanged");
